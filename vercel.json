{
  "redirects": [
    {
      "source": "/name",
      "destination": "/name/",
      "permanent": false
    },
    {
      "source": "/gua",
      "destination": "/gua/",
      "permanent": false
    },
    {
      "source": "/codecraft",
      "destination": "/codecraft/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/codecraft/:path*",
      "destination": "/codecraft/index.html"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://cyber-gua.vercel.app/_next/:path*"
    },
    {
      "source": "/name/sitemap.xml",
      "destination": "https://name-cradle-git-main-busivaagmailcoms-projects.vercel.app/sitemap.xml"
    },
    {
      "source": "/name/robots.txt",
      "destination": "https://name-cradle-git-main-busivaagmailcoms-projects.vercel.app/robots.txt"
    },
    {
      "source": "/name/",
      "destination": "https://name-cradle-git-main-busivaagmailcoms-projects.vercel.app/"
    },
    {
      "source": "/name/:path*",
      "destination": "https://name-cradle-git-main-busivaagmailcoms-projects.vercel.app/:path*"
    },
    {
      "source": "/gua/",
      "destination": "https://cyber-gua.vercel.app/"
    },
    {
      "source": "/gua/:path*",
      "destination": "https://cyber-gua.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/name",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/name/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/name/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ]
}
