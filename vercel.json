{
  "rewrites": [
    {
      "source": "/name/sitemap.xml",
      "destination": "https://namecradle.vercel.app/sitemap.xml"
    },
    {
      "source": "/name/robots.txt",
      "destination": "https://namecradle.vercel.app/robots.txt"
    },
    {
      "source": "/name",
      "destination": "https://namecradle.vercel.app/"
    },
    {
      "source": "/name/:path*",
      "destination": "https://namecradle.vercel.app/:path*"
    }
  ]
}
